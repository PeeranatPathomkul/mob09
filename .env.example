# --- database ---
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=flash_sale

# --- redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- auth ---
JWT_SECRET=change-me

# --- api ---
PORT=3000

# --- write-path / worker tuning ---
# Which stock-claim implementation the worker uses.
# pessimistic (default, shipped) | optimistic (benchmark only) | atomic (single-statement CTE)
STOCK_CLAIM_STRATEGY=pessimistic

# In-flight jobs per worker process.
WORKER_CONCURRENCY=10

# Must be >= WORKER_CONCURRENCY, otherwise jobs queue for a connection before
# they ever reach the row lock. Rule of thumb: concurrency + 2.
DB_POOL_MAX=12

# How long a transaction waits for the contended row before giving up.
# Failing fast produces a retryable 55P03 instead of an invisible backlog.
DB_LOCK_TIMEOUT=5s

# Bumped by the worker after every committed stock change so readers can tell
# their cached pages are stale.
CACHE_VERSION_KEY=products:cache:version

# --- read-path / product cache (GET /api/v1/products) ---
# Page cache TTL is a jittered range, not a fixed value, so every key for a
# version doesn't expire in the same instant. It's a safety net that cleans
# up old-version keys — correctness comes from CACHE_VERSION_KEY, not this.
PRODUCT_CACHE_TTL_MIN_SECONDS=30
PRODUCT_CACHE_TTL_MAX_SECONDS=60

# Rebuild mutex: how long one caller holds the lock while it queries Postgres
# and refills the page cache, and how many times/how often a caller who lost
# the race polls for that result before giving up and querying itself.
PRODUCT_CACHE_LOCK_TTL_SECONDS=5
PRODUCT_CACHE_LOCK_RETRY_MAX=5
PRODUCT_CACHE_LOCK_RETRY_DELAY_MS=50
